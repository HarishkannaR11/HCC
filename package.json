{
  "name": "hcc-coding-tool",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "tsx scripts/check-client-bundle.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start -x storage-api,imgproxy,vector,logflare,supavisor,edge-runtime,studio,realtime,postgres-meta,mailpit",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "data:build": "tsx scripts/build-reference-data.ts",
    "data:load": "tsx scripts/load-reference-data.ts",
    "data:verify": "tsx scripts/verify-reference-data.ts",
    "db:seed-charts": "tsx scripts/seed-charts.ts",
    "db:seed": "npm run data:build && npm run data:load && npm run db:seed-charts",
    "db:seed:fixture": "npm run data:build -- --source data/fixtures/py2026 --fixture && npm run data:load && npm run db:seed-charts",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.1",
    "prettier": "^3.6.2",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
